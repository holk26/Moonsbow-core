APP_NAME=Moonsbow Core
APP_ENV=production
APP_DEBUG=False
APP_PORT=8000
APP_MODE=api
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
CORS_ORIGINS=["https://yourdomain.com"]

# ── Database ──────────────────────────────────────────────────────────────────
# Replace "postgres" with the hostname of your PostgreSQL service on the Docker
# network (Dokploy uses the service name as the hostname by default).
DATABASE_URL=postgresql+asyncpg://moonsbow:moonsbow@postgres:5432/moonsbow
# Atlas uses the plain postgresql:// driver (not asyncpg)
ATLAS_DATABASE_URL=postgresql://moonsbow:moonsbow@postgres:5432/moonsbow

# ── Redis ─────────────────────────────────────────────────────────────────────
# Replace "redis" with the hostname of your Redis service on the Docker network.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Worker tuning (optional) ─────────────────────────────────────────────────
UVICORN_WORKERS=1
CELERY_CONCURRENCY=4
