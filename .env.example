APP_NAME=Moonsbow Core
APP_ENV=development
APP_DEBUG=True
APP_PORT=8000
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
DATABASE_URL=postgresql+asyncpg://moonsbow:moonsbow@localhost:5432/moonsbow
# Atlas uses the plain postgresql:// driver (not asyncpg)
ATLAS_DATABASE_URL=postgresql://moonsbow:moonsbow@localhost:5432/moonsbow
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
